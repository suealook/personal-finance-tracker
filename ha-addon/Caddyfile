# Terminates HTTPS on the add-on's exposed port and reverse-proxies to the
# Flask app, which listens on an internal-only port (127.0.0.1:5001, not
# exposed outside the container). `tls internal` makes Caddy generate and
# manage its own local CA + certificate automatically — the browser still
# needs a one-time "trust this certificate" step per device (same tradeoff
# as any self-signed setup), but the TLS handling itself is Caddy's
# production-grade implementation instead of Flask's dev-server SSL support,
# which turned out to be unreliable under real browser connection patterns.
{
	admin off
	# HTTP/3 needs UDP, which adds nothing for a single-user LAN dashboard
	# and is one more thing that can go wrong on an unusual network path.
	servers {
		protocols h1 h2
	}
}

:5000 {
	tls internal
	reverse_proxy 127.0.0.1:5001
}
