# Terminates HTTPS on the standard port and reverse-proxies to the Flask
# app, which listens on an internal-only port (127.0.0.1:5000, not exposed
# outside the VM). `tls internal` makes Caddy generate and manage its own
# local CA + certificate automatically, since there's no domain to get a
# real Let's Encrypt certificate for yet — every device needs a one-time
# "trust this certificate" step on first visit. See DEPLOY.md's last
# section for upgrading to a real, browser-trusted certificate once you
# have a domain (even a free one).
{
	admin off
}

:443 {
	tls internal
	reverse_proxy 127.0.0.1:5000
}
