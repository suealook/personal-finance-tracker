[Unit]
Description=Personal Finance Tracker - Telegram Bot
After=network.target

[Service]
Type=simple
# Replace CHANGE_ME below with your actual login user (run `whoami` on the
# VM to check) and adjust the paths if the repo isn't cloned to your home
# directory as ~/personal-finance.
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/personal-finance
ExecStart=/home/CHANGE_ME/personal-finance/venv/bin/python scripts/run_bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
