# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID from @userinfobot (whitelists the bot to only you)
TELEGRAM_ALLOWED_USER_ID=

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Path to the Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=data/credentials/service_account.json

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for parsing + monthly analysis
CLAUDE_MODEL=claude-sonnet-5

# Flask dashboard bind host/port. Local dev: leave WEB_BIND_HOST at 127.0.0.1
# (loopback-only, trusted). On a server meant to be reached from elsewhere,
# set WEB_BIND_HOST=0.0.0.0 (or a specific interface) — DASHBOARD_PASSWORD
# then becomes required; the app refuses to start without it.
WEB_PORT=5000
WEB_BIND_HOST=127.0.0.1

# Required whenever WEB_BIND_HOST isn't loopback-only. Optional locally.
DASHBOARD_PASSWORD=
# Optional — leave blank to sign in with just the password above (any
# username accepted); set it to require both.
DASHBOARD_USERNAME=

# Leave unset/blank in every deployment (including behind a reverse proxy on
# 127.0.0.1 — the proxy forwards everything, debugger included, to whoever's
# on the other end). Only set to "1" on your own local dev machine, if you
# specifically want Flask's interactive debugger for a crash you're chasing.
FLASK_DEBUG=
