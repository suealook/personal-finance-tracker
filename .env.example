# Telegram bot token from @BotFather. One shared bot for everyone — who's
# actually allowed to use it, and whose sheet their messages go to, is
# data/users.json (see common/users.py), not a setting here.
TELEGRAM_BOT_TOKEN=

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Bootstrap-only default for `python scripts/init_sheet.py` when run with no
# argument — not read anywhere else. Each user's real sheet id lives in
# data/users.json.
GOOGLE_SHEET_ID=

# Path to the Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=data/credentials/service_account.json

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for parsing + monthly analysis
CLAUDE_MODEL=claude-sonnet-5

# Flask dashboard bind host/port. Local dev: leave WEB_BIND_HOST at 127.0.0.1
# (loopback-only, trusted). On a server meant to be reached from elsewhere,
# set WEB_BIND_HOST=0.0.0.0 (or a specific interface) — GOOGLE_OAUTH_CLIENT_ID
# then becomes required; the app refuses to start without it.
WEB_PORT=5000
WEB_BIND_HOST=127.0.0.1

# "Sign in with Google" OAuth client. Create one in the GCP Console under
# APIs & Services -> Credentials -> OAuth client ID (Web application). Google
# requires a real domain for the authorized redirect URI — a bare IP is
# rejected — so this is a later step for a real deployment (see DEPLOY.md);
# for local dev the redirect URI is just http://127.0.0.1:5000/auth/google/callback.
# Required whenever WEB_BIND_HOST isn't loopback-only. Optional locally —
# leaving these blank disables the login gate entirely.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Leave unset/blank in every deployment (including behind a reverse proxy on
# 127.0.0.1 — the proxy forwards everything, debugger included, to whoever's
# on the other end). Only set to "1" on your own local dev machine, if you
# specifically want Flask's interactive debugger for a crash you're chasing.
FLASK_DEBUG=
